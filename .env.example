# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Keep secret — server-side only

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # From Stripe dashboard → Webhooks → signing secret

# Price IDs from https://dashboard.stripe.com/products
STRIPE_INDIVIDUAL_MONTHLY_PRICE_ID=price_...
STRIPE_INDIVIDUAL_ANNUAL_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...   # Used in stripe-webhook.js for plan detection

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# Credentials from Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# ─── Admin ───────────────────────────────────────────────────────────────────
# Arbitrary secret used to authenticate requests to the admin-track function
ADMIN_KEY=choose-a-strong-random-string

# ─── Netlify ─────────────────────────────────────────────────────────────────
# Set automatically by Netlify in deployed environments — only needed locally
URL=http://localhost:8888
